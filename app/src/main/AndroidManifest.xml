<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Android 11+ 包可见性：允许查询已安装应用（用于按名字打开应用） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="语音管家"
        android:icon="@android:drawable/sym_def_app_icon"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 常驻语音服务：唤醒词监听 + 本地识别 + DeepSeek 大脑
             exported 由 gradle 属性 exportService 控制：模拟器调试 true，手机 false -->
        <service
            android:name=".AgentService"
            android:exported="${agentServiceExported}"
            android:foregroundServiceType="microphone" />

        <!-- 无障碍服务：操作手机（点按/输入/滑动/返回） -->
        <service
            android:name=".HandsService"
            android:exported="true"
            android:label="语音管家操作"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/hands_service" />
        </service>

        <!-- 隐藏输入法：给自绘搜索框（高德等）注入文字 -->
        <service
            android:name=".AgentImeService"
            android:exported="true"
            android:label="语音管家键盘"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/agent_ime" />
        </service>
    </application>
</manifest>
